{
    "mcpServers": {
        "github-research": {
            "enabled": true,
            "type": "stdio",
            "command": "D:/DeerFlow/DeerFlow++/build/Release/github-research-mcp.exe",
            "args": [],
            "env": {
                "GITHUB_TOKEN": "${GITHUB_TOKEN}",
                "GITHUB_RESEARCH_TIMEOUT": "30"
            },
            "tool_call_timeout": 60,
            "description": "GitHub repository data collection for deep research (WebView2 browser backend)"
        },
        "brave-search": {
            "enabled": true,
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-brave-search"],
            "env": {
                "BRAVE_API_KEY": "${BRAVE_API_KEY}"
            }
        },
        "fetch": {
            "enabled": true,
            "type": "stdio",
            "command": "uvx",
            "args": ["mcp-server-fetch"]
        },
        "filesystem": {
            "enabled": true,
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-filesystem", "D:/DeerFlow/research_reports"]
        }
    }
}
